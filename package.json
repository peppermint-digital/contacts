{
    "name": "@peppermint-digital/contacts",
    "version": "0.20.0",
    "description": "Kontakt-Kern zum PHP-Paket: die Typen nach vCard und die Regel, welche Anschrift auf welchen Beleg gehoert — ohne ein Wort Oberflaechentext.",
    "license": "MIT",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "prepare": "npm run build"
    },
    "devDependencies": {
        "tsup": "^8.0.0",
        "typescript": "^5.4.0",
        "vitest": "^5.0.0",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "jsdom": "^30.0.1"
    },
    "dependencies": {
        "clsx": "^2.1.1",
        "tailwind-merge": "^3.2.0"
    },
    "peerDependencies": {
        "react": "^18 || ^19",
        "react-dom": "^18 || ^19"
    }
}
